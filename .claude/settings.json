{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(python tools/check_links.py:*)",
      "Bash(python tools/install_skills.py:*)",
      "Bash(python3 tools/update.py:*)",
      "Bash(python tools/update.py:*)",
      "Bash(python3 tools/friction.py:*)",
      "Bash(python tools/friction.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/update.py\" hook",
            "timeout": 180,
            "statusMessage": "Checking GitHub for a newer version of the skills"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/check_links.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking links and skill integrity"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/friction.py\" brief",
            "timeout": 10,
            "statusMessage": "Reading what this skill got wrong before"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/friction.py\" check",
            "timeout": 10,
            "statusMessage": "Checking the friction log"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-autosync.sh\" || true",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Syncing to git..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/friction.py\" flush",
            "timeout": 90,
            "statusMessage": "Sending friction upstream"
          }
        ]
      }
    ]
  }
}
