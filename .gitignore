# Film output. Frames, takes, mixes and masters go here and never into git. Matches at any
# depth, so a film's own out/ inside an examples/ folder is covered too.
out/

# Model checkpoints — never under LFS, never tracked.
checkpoints/
*.ckpt
*.safetensors

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local overrides
.claude/settings.local.json

# Temporary session state (handoffs, scratch). Lives on disk until its run ships, never in git.
tmp-*/
